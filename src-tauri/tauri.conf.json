{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enspirewrite",
  "version": "0.1.0",
  "identifier": "com.enspirewrite.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Enspirewrite — Tactile Typewriter Journal",
        "width": 1100,
        "height": 780,
        "minWidth": 640,
        "minHeight": 500,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
